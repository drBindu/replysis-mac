<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InterviewCopilotMac6.Views.SettingsWindow"
        Title="Settings" Height="960" Width="560"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#1e222a"/>
      <Setter Property="Foreground" Value="#e2e8f0"/>
      <Setter Property="BorderBrush" Value="#333842"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="ComboBoxItem">
      <Setter Property="Foreground" Value="#cbd5e1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="TextBox.DarkInput">
      <Setter Property="Background" Value="#1e222a"/>
      <Setter Property="Foreground" Value="#e2e8f0"/>
      <Setter Property="BorderBrush" Value="#333842"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="TextBlock.SectionLabel">
      <Setter Property="Foreground" Value="#6b7280"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="2,0,0,5"/>
    </Style>

    <Style Selector="TextBlock.HintLabel">
      <Setter Property="Foreground" Value="#3d4d5f"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="4,2,0,0"/>
    </Style>

    <Style Selector="Button.SaveBtn">
      <Setter Property="Background" Value="#2563eb"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.SaveBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3b82f6"/>
    </Style>

  </Window.Styles>

  <Border Background="#12151c" BorderBrush="#2a2f3a" BorderThickness="1" CornerRadius="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- HEADER -->
      <Border Grid.Row="0" Background="#0f1219" CornerRadius="14,14,0,0"
              Padding="22,16,22,14" BorderBrush="#1e232d" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#1e3a5f" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
              <TextBlock Text="⚙" Foreground="#60a5fa" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
              <TextBlock Text="Settings" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="AI Model, Keys, Audio, Account, Transparency"
                         Foreground="#4b5563" FontSize="10"/>
            </StackPanel>
          </StackPanel>
          <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Click="CancelBtn_Click" Foreground="#4b5563" Background="Transparent"
                  BorderThickness="0" FontSize="16" Cursor="Hand" Padding="4,0"
                  DockPanel.Dock="Right"/>
        </DockPanel>
      </Border>

      <!-- CONTENT -->
      <ScrollViewer Grid.Row="1" Padding="22,16,22,8">
        <StackPanel>

          <TextBlock Text="AI MODEL" Classes="SectionLabel"/>
          <ComboBox x:Name="ModelCombo">
            <ComboBoxItem Content="GPT-4.1 (OpenAI — Best Quality)" IsSelected="True"/>
            <ComboBoxItem Content="GPT-4o-mini (OpenAI — Fast + Cheap)"/>
            <ComboBoxItem Content="GPT-4o (OpenAI — Balanced)"/>
            <ComboBoxItem Content="Llama 3.3 70B (Groq — Free)"/>
            <ComboBoxItem Content="Gemini 2.0 Flash (Google)"/>
          </ComboBox>
          <TextBlock Text="GPT-4.1 recommended for interviews. Groq/Gemini = free but weaker."
                     Classes="HintLabel" Margin="4,2,0,16"/>

          <TextBlock Text="AI API KEY" Classes="SectionLabel"/>
          <TextBox x:Name="ApiKeyBox" Classes="DarkInput"/>
          <TextBlock Text="OpenAI: sk-...  |  Groq: gsk_...  |  Gemini: AIza..."
                     Classes="HintLabel" Margin="4,2,0,16"/>

          <Border Height="1" Background="#1e232d" Margin="0,4,0,16"/>

          <!-- COOPILOTX ACCOUNT -->
          <Border Background="#0a1628" CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                  BorderBrush="#1e3a5f" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#1e3a5f" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
                  <TextBlock Text="⚡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="CoopilotX Account" Foreground="#60a5fa" FontSize="12"
                             FontWeight="Bold"/>
                  <TextBlock Text="Sync your credits with coopilotxai.com" Foreground="#3d4d5f" FontSize="10"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="ACCOUNT EMAIL" Classes="SectionLabel"/>
              <TextBox x:Name="CoopilotEmailBox" Classes="DarkInput" Height="36" Padding="10,6"/>
              <TextBlock Text="Enter your coopilotxai.com login email to show credits in the app"
                         Classes="HintLabel" Margin="4,4,0,0"/>
            </StackPanel>
          </Border>

          <Border Height="1" Background="#1e232d" Margin="0,4,0,16"/>

          <TextBlock Text="AUDIO INPUT DEVICE" Classes="SectionLabel"/>
          <ComboBox x:Name="AudioDeviceCombo"/>
          <TextBlock Text="Use headset mic for best accuracy."
                     Classes="HintLabel" Margin="4,2,0,16"/>

          <Border Height="1" Background="#1e232d" Margin="0,4,0,16"/>

          <TextBlock Text="TRANSPARENCY" Classes="SectionLabel"/>

          <DockPanel Margin="0,4,0,4">
            <TextBlock Text="Main Window" Foreground="#94a3b8" FontSize="12"
                       VerticalAlignment="Center" Width="120"/>
            <Border Background="#1e3a5f" CornerRadius="4" Padding="8,2"
                    HorizontalAlignment="Right" DockPanel.Dock="Right">
              <TextBlock x:Name="MainOpacityLabel" Text="98%"
                         Foreground="#60a5fa" FontSize="12" FontWeight="Bold"
                         FontFamily="Menlo, Consolas, monospace"/>
            </Border>
          </DockPanel>
          <Slider x:Name="MainOpacitySlider" Minimum="10" Maximum="100" Value="98"
                  TickFrequency="5"
                  ValueChanged="MainOpacitySlider_ValueChanged" Margin="0,0,0,4"/>
          <DockPanel Margin="4,0,4,12">
            <TextBlock Text="10% — Nearly hidden" Foreground="#3d4d5f" FontSize="9"/>
            <TextBlock Text="100% — Fully visible" Foreground="#3d4d5f" FontSize="9"
                       HorizontalAlignment="Right"/>
          </DockPanel>

          <DockPanel Margin="0,4,0,4">
            <TextBlock Text="Camera Overlay" Foreground="#94a3b8" FontSize="12"
                       VerticalAlignment="Center" Width="120"/>
            <Border Background="#1e3a5f" CornerRadius="4" Padding="8,2"
                    HorizontalAlignment="Right" DockPanel.Dock="Right">
              <TextBlock x:Name="OverlayOpacityLabel" Text="90%"
                         Foreground="#60a5fa" FontSize="12" FontWeight="Bold"
                         FontFamily="Menlo, Consolas, monospace"/>
            </Border>
          </DockPanel>
          <Slider x:Name="OverlayOpacitySlider" Minimum="10" Maximum="100" Value="90"
                  TickFrequency="5"
                  ValueChanged="OverlayOpacitySlider_ValueChanged" Margin="0,0,0,4"/>
          <DockPanel Margin="4,0,4,12">
            <TextBlock Text="10% — Ghost overlay" Foreground="#3d4d5f" FontSize="9"/>
            <TextBlock Text="100% — Fully opaque" Foreground="#3d4d5f" FontSize="9"
                       HorizontalAlignment="Right"/>
          </DockPanel>

          <Border Height="1" Background="#1e232d" Margin="0,4,0,16"/>

          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="TEMPERATURE" Classes="SectionLabel" VerticalAlignment="Center"/>
            <Border Background="#1e3a5f" CornerRadius="4" Padding="8,2"
                    HorizontalAlignment="Right" DockPanel.Dock="Right">
              <TextBlock x:Name="TempLabel" Text="0.2"
                         Foreground="#60a5fa" FontSize="12" FontWeight="Bold"
                         FontFamily="Menlo, Consolas, monospace"/>
            </Border>
          </DockPanel>
          <Slider x:Name="TempSlider" Minimum="0" Maximum="1" Value="0.2"
                  TickFrequency="0.1"
                  ValueChanged="TempSlider_ValueChanged" Margin="0,0,0,4"/>
          <DockPanel Margin="4,0,4,12">
            <TextBlock Text="0.0 — Precise" Foreground="#3d4d5f" FontSize="9"/>
            <TextBlock Text="1.0 — Creative" Foreground="#3d4d5f" FontSize="9"
                       HorizontalAlignment="Right"/>
          </DockPanel>

          <!-- SOFTWARE UPDATE -->
          <Border Height="1" Background="#1e232d" Margin="0,4,0,16"/>
          <Border Background="#0a1120" CornerRadius="10" Padding="14,12"
                  Margin="0,0,0,16" BorderBrush="#1e2d4a" BorderThickness="1">
            <DockPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SOFTWARE UPDATE" Foreground="#6b7280"
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="AppVersionLabel" Foreground="#94a3b8" FontSize="12"/>
                <TextBlock x:Name="UpdateStatusLabel" Text="" Foreground="#4ade80"
                           FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Vertical" HorizontalAlignment="Right" DockPanel.Dock="Right" Spacing="6">
                <Button x:Name="CheckUpdatesBtn" Content="Check for Updates"
                        Click="CheckUpdatesBtn_Click"
                        Background="#1e3a5f" Foreground="#60a5fa"
                        BorderThickness="1" BorderBrush="#2a5a8f"
                        CornerRadius="7" FontSize="12" FontWeight="SemiBold"
                        Height="34" Padding="14,6" Cursor="Hand"/>
                <Button x:Name="RestartUpdateBtn" Content="Restart to Update"
                        IsVisible="False"
                        Click="RestartUpdateBtn_Click"
                        Background="#14532d" Foreground="#4ade80"
                        BorderThickness="1" BorderBrush="#166534"
                        CornerRadius="7" FontSize="12" FontWeight="SemiBold"
                        Height="34" Padding="14,6" Cursor="Hand"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Background="#0d1117" CornerRadius="8" Padding="14,10"
                  Margin="0,4,0,8" BorderBrush="#1e232d" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="💡 Quick Guide" Foreground="#60a5fa"
                         FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
              <TextBlock Foreground="#4b5563" FontSize="10.5"
                         TextWrapping="Wrap" LineHeight="18">
                • For interviews: GPT-4.1 + temp 0.2 = sharp, consistent answers&#10;• For practice: GPT-4o-mini + temp 0.4 = fast and cheap&#10;• Free option: Groq Llama 3.3 (rate limited, weaker quality)&#10;• Transparency: lower main window opacity to blend into screen&#10;• CoopilotX email: enter to see your credits balance in the app&#10;• Keys saved locally — never sent anywhere except the AI provider
              </TextBlock>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- FOOTER -->
      <Border Grid.Row="2" Background="#0f1219" CornerRadius="0,0,14,14"
              Padding="22,14" BorderBrush="#1e232d" BorderThickness="0,1,0,0">
        <DockPanel>
          <TextBlock Text="Config saved to ~/Library/Application Support/InterviewCopilot"
                     Foreground="#2a2f3a" FontSize="9" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
            <Button Content="Cancel" Click="CancelBtn_Click" Width="80" Height="34"
                    Background="Transparent" Foreground="#6b7280"
                    BorderThickness="0" Cursor="Hand" FontSize="13"/>
            <Button x:Name="SaveBtn" Content="Save &amp; Apply"
                    Classes="SaveBtn" Click="SaveBtn_Click"
                    Width="130" Height="34" Padding="14,6"/>
          </StackPanel>
        </DockPanel>
      </Border>

    </Grid>
  </Border>
</Window>