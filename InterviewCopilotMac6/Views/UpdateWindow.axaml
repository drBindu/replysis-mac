<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InterviewCopilotMac6.Views.UpdateWindow"
        Title="Update Available"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent">

  <Window.Styles>
    <Style Selector="Button.Outline">
      <Setter Property="Background"   Value="#1e2433"/>
      <Setter Property="Foreground"   Value="#8b949e"/>
      <Setter Property="BorderBrush"  Value="#30363d"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Height"       Value="40"/>
      <Setter Property="FontSize"     Value="13"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.Outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#252d3d"/>
    </Style>
    <Style Selector="Button.Primary">
      <Setter Property="Background"   Value="#1a3a6b"/>
      <Setter Property="Foreground"   Value="#38BDF8"/>
      <Setter Property="BorderBrush"  Value="#1e5799"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Height"       Value="40"/>
      <Setter Property="FontSize"     Value="13"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1d4585"/>
    </Style>
  </Window.Styles>

  <Border Background="#0d1117"
          CornerRadius="16"
          BorderBrush="#21262d"
          BorderThickness="1"
          PointerPressed="TitleBar_PointerPressed">

    <StackPanel Margin="28,24,28,28">

      <!-- Title bar -->
      <DockPanel Margin="0,0,0,20">
        <Button DockPanel.Dock="Right"
                Content="✕"
                Click="Close_Click"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#6b7280"
                FontSize="15"
                Cursor="Hand"
                Padding="6,2"/>
        <TextBlock Text="SOFTWARE UPDATE"
                   Foreground="#6b7280"
                   FontSize="10"
                   FontWeight="Bold"
                   LetterSpacing="2"
                   VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Icon + version info -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Border Background="#0f1f40"
                CornerRadius="12"
                Width="52" Height="52"
                Margin="0,0,16,0">
          <TextBlock Text="↑"
                     FontSize="28"
                     FontWeight="Bold"
                     Foreground="#38BDF8"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TitleText"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="#e6edf3"/>
          <TextBlock x:Name="SubtitleText"
                     FontSize="12"
                     Foreground="#8b949e"
                     Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>

      <!-- Divider -->
      <Border Background="#21262d" Height="1" Margin="0,0,0,16"/>

      <!-- What's new -->
      <TextBlock Text="WHAT'S NEW"
                 FontSize="10"
                 FontWeight="Bold"
                 Foreground="#6b7280"
                 LetterSpacing="2"
                 Margin="0,0,0,8"/>
      <Border Background="#161b22"
              CornerRadius="8"
              Padding="14,12"
              Margin="0,0,0,20">
        <TextBlock x:Name="DescText"
                   Foreground="#8b949e"
                   FontSize="12"
                   TextWrapping="Wrap"
                   LineHeight="18"/>
      </Border>

      <!-- Download progress (hidden until download starts) -->
      <StackPanel x:Name="ProgressPanel" IsVisible="False" Margin="0,0,0,12">
        <DockPanel Margin="0,0,0,6">
          <TextBlock x:Name="StatusText"
                     Foreground="#8b949e"
                     FontSize="11"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="PctText"
                     DockPanel.Dock="Right"
                     Foreground="#38BDF8"
                     FontSize="11"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </DockPanel>
        <ProgressBar x:Name="ProgressBar"
                     Height="4"
                     CornerRadius="2"
                     Background="#21262d"
                     Foreground="#38BDF8"
                     Minimum="0" Maximum="100" Value="0"/>
      </StackPanel>

      <!-- Auto-restart note (shown during download) -->
      <TextBlock x:Name="NoteText"
                 IsVisible="False"
                 Foreground="#6b7280"
                 FontSize="11"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,16"/>

      <!-- Restart Now / Later panel (shown when download completes) -->
      <StackPanel x:Name="RestartPanel" IsVisible="False" Margin="0,0,0,4">
        <Border Background="#0a2118" BorderBrush="#1a5c35" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="✓  Ready to install!"
                       Foreground="#4ade80" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Restart now to apply, or come back later via Settings → Software Update."
                       Foreground="#6b7280" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,12,*">
          <Button Grid.Column="0" x:Name="RestartLaterBtn" Classes="Outline"
                  Content="Restart Later" Click="RestartLater_Click"/>
          <Button Grid.Column="2" x:Name="RestartNowBtn" Classes="Primary"
                  Content="Restart Now" Click="RestartNow_Click"/>
        </Grid>
      </StackPanel>

      <!-- Error banner -->
      <Border x:Name="ErrorPanel"
              IsVisible="False"
              Background="#2d1818"
              BorderBrush="#5c2020"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,10"
              Margin="0,0,0,16">
        <TextBlock x:Name="ErrorText"
                   Foreground="#f87171"
                   FontSize="12"
                   TextWrapping="Wrap"/>
      </Border>

      <!-- Action buttons -->
      <Grid ColumnDefinitions="*,12,*">
        <Button Grid.Column="0"
                x:Name="LaterBtn"
                Classes="Outline"
                Content="Later"
                Click="Later_Click"/>
        <Button Grid.Column="2"
                x:Name="ActionBtn"
                Classes="Primary"
                Content="Update Now"
                Click="Action_Click"/>
      </Grid>

    </StackPanel>
  </Border>
</Window>
