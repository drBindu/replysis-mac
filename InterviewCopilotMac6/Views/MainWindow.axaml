<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InterviewCopilotMac6.Views.MainWindow"
        Title="Interview Copilot"
        Width="1120" Height="740"
        MinWidth="760" MinHeight="480"
        CanResize="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        KeyDown="Window_KeyDown">

  <Window.Styles>

    <Style Selector="Button.GreenBtn">
      <Setter Property="Background" Value="#1a6b3a"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI, sans-serif"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.GreenBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22c55e"/>
    </Style>

    <Style Selector="Button.RedBtn">
      <Setter Property="Background" Value="#991b1b"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI, sans-serif"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.RedBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#ef4444"/>
    </Style>

    <Style Selector="Button.GhostBtn">
      <Setter Property="Background" Value="#1A1F2E"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.GhostBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2D3748"/>
    </Style>

    <Style Selector="Button.BlueBtn">
      <Setter Property="Background" Value="#1E3A5F"/>
      <Setter Property="Foreground" Value="#38BDF8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2255AA"/>
      <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI, sans-serif"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.BlueBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1e4a7a"/>
    </Style>

    <Style Selector="Button.MicBtn">
      <Setter Property="Background" Value="#1a1f2e"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="#ef4444"/>
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="CornerRadius" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.MicBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2d3748"/>
    </Style>

    <Style Selector="Button.ArrowBtn">
      <Setter Property="Background" Value="#1A1F2E"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.ArrowBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2D3748"/>
    </Style>

    <!-- Smooth hover transitions for all themed buttons -->
    <Style Selector="Button.GreenBtn /template/ ContentPresenter, Button.RedBtn /template/ ContentPresenter, Button.GhostBtn /template/ ContentPresenter, Button.BlueBtn /template/ ContentPresenter, Button.MicBtn /template/ ContentPresenter, Button.ArrowBtn /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>

  </Window.Styles>

  <Border x:Name="MainAppBorder" Background="#B3080C14" CornerRadius="14"
          BorderBrush="#55FFFFFF" BorderThickness="1"
          PointerPressed="Border_PointerPressed">
    <Grid>

      <!-- NORMAL MODE -->
      <Grid x:Name="NormalModeGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="68"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#CC0D1117" CornerRadius="14,14,0,0"
                BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Logo -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Image Source="/Assets/AppIcon.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Interview Copilot" Foreground="White" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="by CoopilotX" Foreground="#3d4d5f" FontSize="9"/>
              </StackPanel>
            </StackPanel>

            <!-- CENTER: Mic + Status + Record -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button x:Name="MicBtn" Classes="MicBtn" Click="MicBtn_Click" Margin="0,0,16,0" Focusable="False">
                <TextBlock Text="🎤" FontSize="20"/>
              </Button>
              <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"
                          PointerPressed="MicStatus_PointerPressed" Cursor="Hand"
                          ToolTip.Tip="Click to retry speech connection">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="MicIndicator" Width="9" Height="9" Fill="#ef4444" Margin="0,0,8,0"/>
                  <TextBlock x:Name="MicIndicatorText" Text="READY" Foreground="White"
                             FontWeight="Bold" FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- RIGHT: Credits + Profile + Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

              <!-- Credits Badge (hidden when logged out) -->
              <Border x:Name="CreditsBadge" Background="#0f2a1a" CornerRadius="8"
                      Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center"
                      BorderBrush="#1a6b3a" BorderThickness="1" Cursor="Hand"
                      IsVisible="False"
                      PointerPressed="CreditsBadge_Click"
                      ToolTip.Tip="Credits · Click to refresh">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="CreditsIcon" Text="⚡" FontSize="11"
                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CreditsLabel" Text="…"
                               Foreground="#4ade80" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="CreditsPlanLabel" Text=""
                               Foreground="#3d4d5f" FontSize="9" IsVisible="False"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Profile Badge (visible when logged in) -->
              <Border x:Name="ProfileBadge" CornerRadius="8" Padding="8,5"
                      Margin="0,0,8,0" VerticalAlignment="Center"
                      Background="#0f1a2e" BorderBrush="#1e3a5f" BorderThickness="1"
                      Cursor="Hand" IsVisible="False"
                      PointerPressed="ProfileBadge_Click"
                      ToolTip.Tip="Your account · Click to sign out">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="26" Height="26" CornerRadius="13"
                          Background="#1e3a5f" Margin="0,0,7,0">
                    <TextBlock x:Name="AvatarInitials" Text="?"
                               Foreground="#38BDF8" FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileNameLabel" Text=""
                               Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProfilePlanLabel" Text="free plan"
                               Foreground="#3d4d5f" FontSize="9"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Sign In button (visible when NOT logged in) -->
              <Button x:Name="SignInHeaderBtn" Content="⚡  Sign In"
                      Click="SignInHeaderBtn_Click"
                      Classes="BlueBtn"
                      Padding="12,6" Margin="0,0,8,0"
                      IsVisible="True" Focusable="False"/>

              <!-- My Sessions (visible when logged in) -->
              <Button x:Name="SessionsBtn"
                      Content="📋 My Sessions"
                      Classes="GhostBtn"
                      Click="SessionsBtn_Click"
                      Padding="12,6" Margin="0,0,8,0"
                      IsVisible="False" Focusable="False"
                      ToolTip.Tip="View your past interview recordings"/>

              <!-- Screen Analyze button (F8 / F9) -->
              <Button x:Name="ScreenAnalyzeBtn" Classes="GhostBtn"
                      Click="ScreenAnalyzeBtn_Click"
                      Padding="12,6" Margin="0,0,8,0" Focusable="False"
                      ToolTip.Tip="Analyze screen and get an immediate AI answer (F8 / F9)">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock x:Name="AnalyzeIcon" Text="🔍" FontSize="13"/>
                  <TextBlock x:Name="AnalyzeLabel" Text="Analyze Screen  F9" FontSize="12"/>
                </StackPanel>
              </Button>

              <!-- Camera Mode -->
              <Button Content="📷 Camera Mode" Classes="BlueBtn"
                      Click="CameraMode_Click" Padding="12,6" Margin="0,0,8,0" Focusable="False"/>

              <!-- Settings -->
              <Button Content="⚙" Classes="GhostBtn"
                      Click="SettingsBtn_Click" Padding="10,6" Margin="0,0,8,0"
                      ToolTip.Tip="Settings" Focusable="False"/>

              <!-- Session Timer (visible while session is active) -->
              <Border x:Name="SessionTimerBadge" Background="#0D1B2E" CornerRadius="8"
                      Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center"
                      BorderBrush="#1e3a5f" BorderThickness="1"
                      IsVisible="False" ToolTip.Tip="Session duration">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="⏱" FontSize="10" Margin="0,0,5,0"
                             VerticalAlignment="Center" Foreground="#38BDF8"/>
                  <TextBlock x:Name="SessionTimerLabel" Text="0:00"
                             Foreground="#60a5fa" FontSize="11"
                             FontWeight="Bold" FontFamily="SF Mono, Menlo, monospace"/>
                </StackPanel>
              </Border>

              <!-- Minimize -->
              <Button Content="–" Foreground="#555" Background="Transparent"
                      BorderThickness="0" Click="MinimizeBtn_Click"
                      FontSize="18" ToolTip.Tip="Minimize" Cursor="Hand"
                      Padding="6,0" Margin="0,0,4,0" Focusable="False"/>

              <!-- Close -->
              <Button Content="✕" Foreground="#666666" Background="Transparent"
                      BorderThickness="0" Click="CloseBtn_Click"
                      ToolTip.Tip="Close" Cursor="Hand" Focusable="False"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="22,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Resume Panel -->
          <Grid x:Name="ResumePanel" Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Resume header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="📄 RESUME" Foreground="#2A4A6A" FontSize="9"
                           FontWeight="Bold"/>
                <TextBlock Text="Optional — better answers with it"
                           Foreground="#1a2a3a" FontSize="8" FontStyle="Italic"/>
              </StackPanel>
              <Button Grid.Column="1" x:Name="ResumeUploadBtn" Classes="GhostBtn"
                      Click="ResumeUploadBtn_Click" Padding="10,5"
                      VerticalAlignment="Center" Focusable="False"
                      ToolTip.Tip="Upload a PDF, DOCX or TXT resume">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="⬆" FontSize="11"/>
                  <TextBlock Text="Upload" FontSize="11"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- TextBox with placeholder watermark + drag &amp; drop zone -->
            <Border x:Name="ResumeDropBorder" Grid.Row="1" Background="#CC0D1117" CornerRadius="14"
                    BorderBrush="#22FFFFFF" BorderThickness="1"
                    BoxShadow="0 4 16 0 #30000000"
                    DragDrop.AllowDrop="True">
              <Grid>
                <TextBox x:Name="ResumeTextBox" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="Transparent" Foreground="#CBD5E1"
                         BorderThickness="0" Padding="16"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextChanged="ResumeTextBox_TextChanged"
                         KeyDown="ResumeTextBox_KeyDown"/>
                <TextBlock x:Name="ResumeWatermark"
                           Foreground="#1e3040" FontSize="12" TextWrapping="Wrap"
                           Margin="16,16,16,16" VerticalAlignment="Top"
                           IsHitTestVisible="False" FontStyle="Italic">
                  Paste your resume here, or drag &amp; drop a PDF / DOCX / TXT file — or click "Upload" above.&#x0a;&#x0a;Without it the AI gives generic answers.&#x0a;With it, answers are tailored to your exact experience, companies and skills.
                </TextBlock>

                <!-- Drag-over overlay -->
                <Border x:Name="ResumeDragOverlay" CornerRadius="14"
                        Background="#332563EB" BorderBrush="#3B82F6" BorderThickness="2"
                        IsVisible="False" IsHitTestVisible="False">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="⬇" FontSize="32" Foreground="#93C5FD" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop to load your resume" Foreground="White"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="PDF · DOCX · TXT" Foreground="#93C5FD" FontSize="10"
                               HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Save path / status -->
            <Border Grid.Row="2" Margin="0,10,0,0" Background="#CC0D1117"
                    CornerRadius="10" Padding="10,9">
              <TextBlock x:Name="SavePathLabel" Foreground="#2a3a4a"
                         FontSize="9" TextWrapping="Wrap"/>
            </Border>
          </Grid>

          <!-- Toggle Button -->
          <Button x:Name="ResumeToggleBtn" Grid.Column="1" Content="◀"
                  Classes="ArrowBtn" Click="ResumeToggleBtn_Click"
                  VerticalAlignment="Center" Margin="0,0,14,0" Focusable="False"/>

          <!-- Right Panel -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="1*"/>
              <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Transcript Box -->
            <Border Grid.Row="0" Background="#CC0D1117" CornerRadius="14"
                    BorderBrush="#22FFFFFF" BorderThickness="1"
                    BoxShadow="0 4 16 0 #30000000"
                    Padding="22,18" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hotkey bar + section label -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="INTERVIEWER" Foreground="#2A4A6A" FontSize="9"
                             FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Background="#0D1B2E" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                      <TextBlock Text="SPACE · listen → answer" Foreground="#38BDF8"
                                 FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#0D2E0D" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                      <TextBlock Text="F8 · all screens" Foreground="#4ade80"
                                 FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#0D2E0D" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                      <TextBlock Text="F9 · primary" Foreground="#86efac"
                                 FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#1a0f2e" CornerRadius="5" Padding="8,3">
                      <TextBlock Text="F12 · debug" Foreground="#a78bfa"
                                 FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>
                </Grid>

                <!-- Transcript + watermark hint -->
                <Grid Grid.Row="1">
                  <ScrollViewer x:Name="TranscriptScroll">
                    <TextBlock x:Name="TranscriptTextBlock" Foreground="White"
                               FontSize="15" TextWrapping="Wrap"/>
                  </ScrollViewer>
                  <StackPanel x:Name="TranscriptHint"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              IsHitTestVisible="False" IsVisible="True" Spacing="14">

                    <Border Width="44" Height="44" CornerRadius="22"
                            Background="#0D1B2E" BorderBrush="#1c3350" BorderThickness="1"
                            HorizontalAlignment="Center">
                      <TextBlock Text="🎙" FontSize="18" Foreground="#38BDF8"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                      <TextBlock Text="Ready when you are" Foreground="#3d5876" FontSize="14"
                                 FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="Your conversation will appear here" Foreground="#27384c"
                                 FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <!-- AI Answer Box -->
            <Border Grid.Row="1" Background="#CC080F1E" CornerRadius="14"
                    BorderBrush="#441E3A8A" BorderThickness="1"
                    BoxShadow="0 4 16 0 #30000000"
                    Padding="22,18">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ACTION TOOLBAR -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#0a0f1e" CornerRadius="6" Padding="8,4"
                          VerticalAlignment="Center">
                    <TextBlock Text="🤖  AI Answer" Foreground="#38BDF8"
                               FontSize="9" FontWeight="Bold"/>
                  </Border>
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CopyAnswerBtn" Content="📋 Copy"
                            Click="CopyAnswerBtn_Click"
                            Classes="GhostBtn"
                            Padding="10,5" Margin="0,0,6,0" Focusable="False"
                            ToolTip.Tip="Copy answer to clipboard"/>
                    <Button x:Name="ClearAnswerBtn" Content="✕ Clear"
                            Click="ClearAnswerBtn_Click"
                            Classes="GhostBtn"
                            Padding="10,5" Margin="0,0,6,0" Focusable="False"
                            ToolTip.Tip="Clear current transcript and answer"/>
                    <Button x:Name="NewSessionBtn" Content="＋ New Session"
                            Click="NewSessionBtn_Click"
                            Classes="GreenBtn"
                            Padding="10,5" Focusable="False"
                            ToolTip.Tip="Start a fresh interview session"/>
                  </StackPanel>
                </Grid>

                <!-- THINKING INDICATOR -->
                <StackPanel x:Name="ThinkingPanel" Grid.Row="1" Orientation="Horizontal"
                            IsVisible="False" Margin="0,0,0,10">
                  <TextBlock x:Name="ThinkingLabel" Text="Thinking..."
                             Foreground="#38BDF8" FontSize="12" FontStyle="Italic"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="ThinkingHintLabel"
                             Text=" · F8 all screens  ·  F9 primary"
                             Foreground="#334466" FontSize="11"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- ANSWER -->
                <ScrollViewer Grid.Row="2">
                  <TextBox x:Name="AiAnswerBox"
                           Text="Ready — press SPACE to start listening, then SPACE again to get your answer."
                           Background="Transparent" Foreground="#E2E8F0"
                           BorderThickness="0" FontSize="15"
                           TextWrapping="Wrap" IsReadOnly="True"/>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- RESIZE GRIP — bottom-right corner drag hint -->
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Width="16" Height="16" Cursor="SizeAll"
              Background="Transparent" ZIndex="5"
              PointerPressed="ResizeGrip_PointerPressed">
        <Path Data="M 12,4 L 12,12 L 4,12" Stroke="#334466" StrokeThickness="1.5"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
      </Border>

      <!-- INTRO LAYER -->
      <Border x:Name="IntroLayer" Background="#070609" ZIndex="10">
        <TextBlock Text="Loading..." Foreground="White" FontSize="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

    </Grid>
  </Border>
</Window>
