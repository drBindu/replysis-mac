<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InterviewCopilotMac6.Views"
        x:Class="InterviewCopilotMac6.Views.SessionsWindow"
        Title="My Interview Sessions"
        Width="960" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="False">

  <Window.Styles>
    <Style Selector="Button.GhostBtn">
      <Setter Property="Background" Value="#1A1F2E"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.GhostBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2D3748"/>
    </Style>
    <Style Selector="Button.DangerBtn">
      <Setter Property="Background" Value="#2a0a0a"/>
      <Setter Property="Foreground" Value="#ef4444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#6b1a1a"/>
      <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.DangerBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3d0f0f"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1a2035"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#0f1a3e"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#162050"/>
    </Style>
  </Window.Styles>

  <Border Background="#F0080C14" CornerRadius="14"
          BorderBrush="#44FFFFFF" BorderThickness="1"
          BoxShadow="0 0 40 0 #B3000000">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- HEADER -->
      <Border Grid.Row="0" Background="#CC0D1117" CornerRadius="14,14,0,0"
              BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
              PointerPressed="TitleBar_PointerPressed">
        <Grid Margin="20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#1E3A5F" CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0">
              <TextBlock Text="📋" FontSize="15"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="My Interview Sessions" Foreground="White"
                         FontSize="14" FontWeight="Bold"/>
              <TextBlock x:Name="SubtitleLabel" Text="Loading sessions..."
                         Foreground="#4b5563" FontSize="10"/>
            </StackPanel>
          </StackPanel>

          <Button Grid.Column="2" Content="✕" Click="CloseBtn_Click"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#6b7280" FontSize="16" Cursor="Hand" Padding="8,4"/>
        </Grid>
      </Border>

      <!-- BODY -->
      <Grid Grid.Row="1" Margin="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Sessions list -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="#CC080F1E" CornerRadius="10"
                  BorderBrush="#22FFFFFF" BorderThickness="1">
            <Grid>
              <!-- Empty state -->
              <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                          HorizontalAlignment="Center" IsVisible="True">
                <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="No sessions yet" Foreground="#6b7280"
                           FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Text="Sessions are saved automatically" Foreground="#3d4d5f"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>

              <!-- Sessions list -->
              <ListBox x:Name="SessionsList"
                       Background="Transparent"
                       BorderThickness="0"
                       SelectionChanged="SessionsList_SelectionChanged"
                       Padding="10"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:SessionInfo}">
                    <Grid Margin="0,2">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="🎙" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                      </StackPanel>
                      <TextBlock Grid.Row="2" Text="{Binding DisplayDate}"
                                 Foreground="#38BDF8" FontSize="11"/>
                      <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayStats}"
                                   Foreground="#4ade80" FontSize="10" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DisplayModel}"
                                   Foreground="#4b5563" FontSize="10"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <!-- Delete button -->
          <Button x:Name="DeleteBtn" Grid.Row="1"
                  Content="🗑  Delete Session"
                  Classes="DangerBtn"
                  Click="DeleteBtn_Click"
                  Padding="14,8" Margin="0,10,0,0"
                  HorizontalAlignment="Stretch"
                  IsVisible="False"/>
        </Grid>

        <!-- Splitter -->
        <Border Grid.Column="1" Width="1" Background="#22FFFFFF"
                VerticalAlignment="Stretch" Margin="0,4"/>

        <!-- RIGHT: Transcript viewer -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Session detail header -->
          <Border Grid.Row="0" x:Name="DetailHeader"
                  Background="#CC0D1117" CornerRadius="10"
                  BorderBrush="#22FFFFFF" BorderThickness="1"
                  Padding="16,10" Margin="0,0,0,10"
                  IsVisible="False">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock x:Name="DetailTitle" Text="" Foreground="White"
                           FontSize="14" FontWeight="Bold"/>
                <TextBlock x:Name="DetailMeta" Text="" Foreground="#6b7280"
                           FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyTranscriptBtn"
                        Content="📋 Copy Text"
                        Classes="GhostBtn"
                        Click="CopyTranscriptBtn_Click"
                        Padding="12,6" Margin="0,0,8,0"/>
                <Button x:Name="ExportBtn"
                        Content="⬇ Export .txt"
                        Classes="GhostBtn"
                        Click="ExportBtn_Click"
                        Padding="12,6"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Transcript panel -->
          <Border Grid.Row="1" Background="#CC080F1E" CornerRadius="10"
                  BorderBrush="#441E3A8A" BorderThickness="1">
            <Grid>
              <!-- Placeholder when nothing selected -->
              <StackPanel x:Name="NoSelectionState"
                          VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="←" Foreground="#4b5563" FontSize="32"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Select a session to view its transcript"
                           Foreground="#6b7280" FontSize="13" HorizontalAlignment="Center"/>
              </StackPanel>

              <!-- Transcript scroll -->
              <ScrollViewer x:Name="TranscriptScroll"
                            VerticalScrollBarVisibility="Auto"
                            Padding="20,16"
                            IsVisible="False">
                <StackPanel x:Name="TranscriptPanel"/>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
