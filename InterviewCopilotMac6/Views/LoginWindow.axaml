<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InterviewCopilotMac6.Views.LoginWindow"
        Title="Interview Copilot — Sign In"
        Height="666" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent">

  <Window.Styles>
    <Style Selector="TextBox.AuthInput">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#e6edf3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize"        Value="14"/>
      <Setter Property="Height"          Value="44"/>
      <Setter Property="Padding"         Value="14,11"/>
      <Setter Property="CaretBrush"      Value="#60A5FA"/>
    </Style>
    <Style Selector="Button.LinkBtn">
      <Setter Property="Background"     Value="Transparent"/>
      <Setter Property="Foreground"     Value="#60A5FA"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor"         Value="Hand"/>
      <Setter Property="FontSize"       Value="12"/>
      <Setter Property="Padding"        Value="0"/>
    </Style>
    <Style Selector="Button.LinkBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#93C5FD"/>
    </Style>
  </Window.Styles>

  <!-- Outer shadow / drag area -->
  <Border Background="#0d1117" CornerRadius="18"
          BorderBrush="#30363d" BorderThickness="1"
          PointerPressed="TitleBar_PointerPressed">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ── TITLE BAR ── -->
      <Border Grid.Row="0" Background="Transparent" Padding="14,12,14,0">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Click="CloseBtn_Click"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#6b7280" FontSize="15"
                  Cursor="Hand" Padding="6,2"
                  ToolTip.Tip="Close">✕</Button>
        </DockPanel>
      </Border>

      <!-- ── MAIN CONTENT ── -->
      <StackPanel Grid.Row="1" Margin="36,0,36,36">

        <!-- APP ICON + BRAND -->
        <StackPanel HorizontalAlignment="Center" Margin="0,4,0,28">
          <Border CornerRadius="20" Width="72" Height="72"
                  HorizontalAlignment="Center" Margin="0,0,0,14"
                  ClipToBounds="True">
            <Image Source="avares://InterviewCopilotMac6/Assets/AppIcon.png"
                   Stretch="UniformToFill"/>
          </Border>
          <TextBlock Text="Interview Copilot" Foreground="White"
                     FontSize="20" FontWeight="Bold"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="by CoopilotX" Foreground="#4b5563"
                     FontSize="12" HorizontalAlignment="Center"
                     Margin="0,3,0,0"/>
        </StackPanel>

        <!-- ERROR BANNER -->
        <Border x:Name="ErrorBanner" Background="#1f0a0a" CornerRadius="10"
                Padding="12,10" Margin="0,0,0,14" IsVisible="False"
                BorderBrush="#6b1a1a" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠" Foreground="#f87171" FontSize="13"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ErrorText" Foreground="#fca5a5" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- SUCCESS BANNER -->
        <Border x:Name="SuccessBanner" Background="#0a1f12" CornerRadius="10"
                Padding="12,10" Margin="0,0,0,14" IsVisible="False"
                BorderBrush="#166534" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="✓" Foreground="#4ade80" FontSize="13"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SuccessText" Foreground="#86efac" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- CONTINUE AS (shown when a previous account is remembered) -->
        <Border x:Name="ContinueAsCard" CornerRadius="14" Background="#161b22"
                BorderBrush="#30363d" BorderThickness="1"
                Padding="16" Margin="0,0,0,18" IsVisible="False">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="44" Height="44" CornerRadius="22"
                      Background="#2563EB" ClipToBounds="True">
                <Grid>
                  <TextBlock x:Name="ContinueAsInitials" Text="?" Foreground="White"
                             FontSize="16" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image x:Name="ContinueAsPhoto" Stretch="UniformToFill" IsVisible="False"/>
                </Grid>
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="ContinueAsName" Foreground="White"
                           FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="ContinueAsEmail" Foreground="#9ca3af" FontSize="12"/>
              </StackPanel>
            </StackPanel>

            <Button x:Name="ContinueAsBtn" Click="ContinueAsBtn_Click"
                    Height="44" Cursor="Hand" HorizontalAlignment="Stretch">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border CornerRadius="10" Background="#2563EB">
                    <Grid>
                      <TextBlock x:Name="ContinueAsBtnText" Text="Continue"
                                 Foreground="White" FontSize="14" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock x:Name="ContinueAsLoadingText" Text="Signing in…"
                                 Foreground="#93C5FD" FontSize="13"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="False"/>
                    </Grid>
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>

            <Button x:Name="UseDifferentAccountBtn" Classes="LinkBtn"
                    Content="Use a different account"
                    Click="UseDifferentAccount_Click"
                    HorizontalAlignment="Center" FontSize="12"/>
          </StackPanel>
        </Border>

        <!-- CREDENTIALS FORM (email + password sign-in) -->
        <StackPanel x:Name="CredentialsForm">
        <!-- EMAIL -->
        <TextBlock Text="EMAIL" Foreground="#6b7280" FontSize="10"
                   FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,6"/>
        <Border x:Name="EmailBorder" CornerRadius="10"
                Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
                Margin="0,0,0,16">
          <TextBox x:Name="EmailBox" Classes="AuthInput"
                   GotFocus="EmailBox_GotFocus"
                   LostFocus="EmailBox_LostFocus"
                   KeyDown="Input_KeyDown"/>
        </Border>

        <!-- PASSWORD -->
        <TextBlock Text="PASSWORD" Foreground="#6b7280" FontSize="10"
                   FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,6"/>
        <Border x:Name="PasswordBorder" CornerRadius="10"
                Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
                Margin="0,0,0,4">
          <TextBox x:Name="PasswordBox" Classes="AuthInput"
                   PasswordChar="•"
                   GotFocus="PasswordBox_GotFocus"
                   LostFocus="PasswordBox_LostFocus"
                   KeyDown="Input_KeyDown"/>
        </Border>

        <!-- FORGOT PASSWORD -->
        <Button x:Name="ForgotLink" Classes="LinkBtn"
                Content="Forgot password?"
                Click="ForgotLink_Click"
                HorizontalAlignment="Right"
                Margin="0,6,0,20"/>

        <!-- SIGN IN BUTTON -->
        <Button x:Name="SignInBtn" Click="SignInBtn_Click"
                Height="46" Cursor="Hand" Margin="0,0,0,18"
                HorizontalAlignment="Stretch">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" CornerRadius="10"
                      Background="#2563EB">
                <Grid>
                  <TextBlock x:Name="BtnText" Text="Sign In"
                             Foreground="White" FontSize="14"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="LoadingText" Text="Signing in…"
                             Foreground="#93C5FD" FontSize="13"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsVisible="False"/>
                </Grid>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
        </StackPanel>

        <!-- DIVIDER -->
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Height="1" Background="#21262d"
                  VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="or" Foreground="#4b5563"
                     FontSize="11" Margin="12,0"/>
          <Border Grid.Column="2" Height="1" Background="#21262d"
                  VerticalAlignment="Center"/>
        </Grid>

        <!-- CONTINUE WITH GOOGLE -->
        <Button x:Name="GoogleSignInBtn" Click="GoogleSignInBtn_Click"
                Height="46" Cursor="Hand" Margin="0,0,0,18"
                HorizontalAlignment="Stretch">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border CornerRadius="23" Background="#FFFFFF"
                      BorderBrush="#dadce0" BorderThickness="1">
                <Grid>
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="10">
                    <Canvas Width="18" Height="18">
                      <Path Data="M17.64 9.2045c0-.6381-.0573-1.2518-.1636-1.8409H9v3.4818h4.8436c-.2086 1.125-.8427 2.0782-1.7959 2.7164v2.2581h2.9087c1.7018-1.5668 2.6836-3.874 2.6836-6.6154z" Fill="#4285F4"/>
                      <Path Data="M9 18c2.43 0 4.4673-.8059 5.9564-2.1818l-2.9087-2.2581c-.7959.5345-1.8159.8505-3.0477.8505-2.3441 0-4.3282-1.5832-5.0359-3.7104H.9573v2.3318C2.4382 15.9832 5.4818 18 9 18z" Fill="#34A853"/>
                      <Path Data="M3.9641 10.71c-.18-.5345-.2823-1.1059-.2823-1.71s.1023-1.1755.2823-1.71V4.9582H.9573C.3477 6.1732 0 7.5477 0 9s.3477 2.8268.9573 4.0418L3.9641 10.71z" Fill="#FBBC05"/>
                      <Path Data="M9 3.5795c1.3214 0 2.5077.4541 3.4405 1.346l2.5814-2.5814C13.4632.8918 11.426 0 9 0 5.4818 0 2.4382 2.0168.9573 4.9582L3.9641 7.29C4.6718 5.1627 6.6559 3.5795 9 3.5795z" Fill="#EA4335"/>
                    </Canvas>
                    <TextBlock x:Name="GoogleBtnText" Text="Continue with Google"
                               Foreground="#3c4043" FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="GoogleLoadingText" Text="Connecting…"
                             Foreground="#5f6368" FontSize="13"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="False"/>
                </Grid>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <!-- CREATE ACCOUNT -->
        <StackPanel HorizontalAlignment="Center" Spacing="6">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Don't have an account? " Foreground="#6b7280"
                       FontSize="12" VerticalAlignment="Center"/>
            <Button Classes="LinkBtn"
                    Content="Sign up at coopilotxai.com"
                    Click="RegisterLink_Click"
                    FontSize="12"/>
          </StackPanel>
          <TextBlock Text="Signed up with Google? Use 'Forgot Password' to set a password."
                     Foreground="#4b5563" FontSize="11"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap"
                     TextAlignment="Center"/>
        </StackPanel>

      </StackPanel>
    </Grid>
  </Border>
</Window>
